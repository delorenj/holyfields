{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/agent/memory/retained.v1.json",
  "title": "Agent Memory Retained Event",
  "description": "Broadcast event emitted when an agent retains memory.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../../_common/base_event.v1.json"
    }
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "agent.memory.retained",
      "description": "Event type discriminator"
    },
    "payload": {
      "type": "object",
      "properties": {
        "agent_name": {
          "$ref": "../../_common/types.v1.json#/$defs/agent_name",
          "description": "Agent that retained memory"
        },
        "session_key": {
          "$ref": "../../_common/types.v1.json#/$defs/session_key",
          "description": "Session where retention occurred"
        },
        "memory_bank": {
          "type": "string",
          "minLength": 1,
          "description": "Logical memory bank name"
        },
        "retention_kind": {
          "type": "string",
          "enum": [
            "fact",
            "decision",
            "preference",
            "todo",
            "lesson",
            "summary",
            "other"
          ],
          "description": "Retention classification"
        },
        "memory_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Provider memory ID if available"
        },
        "doc_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source document identifier when provided"
        },
        "source_preview": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200,
          "description": "First 200 chars of retained content"
        },
        "metadata": {
          "type": "object",
          "description": "Provider/session specific metadata"
        }
      },
      "required": [
        "agent_name",
        "session_key",
        "memory_bank",
        "retention_kind"
      ]
    }
  },
  "required": [
    "event_type",
    "payload"
  ]
}
