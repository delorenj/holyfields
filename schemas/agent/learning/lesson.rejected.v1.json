{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://33god.dev/schemas/agent/learning/lesson.rejected.v1.json",
  "title": "Agent Learning Lesson Rejected Event",
  "description": "Candidate lesson rejected after validation or review",
  "type": "object",
  "allOf": [
    { "$ref": "../../_common/base_event.v1.json" }
  ],
  "properties": {
    "event_type": {
      "type": "string",
      "const": "agent.learning.lesson.rejected",
      "description": "Event type discriminator"
    },
    "payload": {
      "type": "object",
      "properties": {
        "candidate_id": {
          "$ref": "../../_common/types.v1.json#/$defs/uuid",
          "description": "Candidate lesson that was rejected"
        },
        "rejection_reason": {
          "type": "string",
          "description": "Primary reason the candidate lesson was rejected"
        },
        "blocking_failures": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Specific validation or review failures that blocked promotion"
        }
      },
      "required": ["candidate_id", "rejection_reason"]
    }
  },
  "required": ["event_type", "payload"]
}
