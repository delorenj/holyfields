{
  "name": "holyfields-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace orchestration for Holyfields contract packages",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/typescript"
  ],
  "scripts": {
    "generate": "bash scripts/generate_typescript.sh",
    "test": "cd packages/typescript && bun test",
    "typecheck": "cd packages/typescript && bun run typecheck",
    "build": "cd packages/typescript && bun run build"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
