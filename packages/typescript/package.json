{
  "name": "@33god/holyfields",
  "version": "0.1.0",
  "description": "TypeScript contracts generated from the Holyfields JSON Schema registry",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./generated/*": {
      "types": "./dist/generated/*.d.ts",
      "import": "./dist/generated/*.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "generate": "bash ../../scripts/generate_typescript.sh",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "prepack": "rm -rf schemas && cp -R ../../schemas schemas && bun run build"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.1.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-zod": "^2.1.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
